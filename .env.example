# Copiez ce fichier en `.env.local` et remplissez les valeurs réelles.
# Ne committez JAMAIS le fichier `.env.local` (il est déjà dans .gitignore).

# Serveur
PORT=3000
HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:3000

# SMTP (Gmail App Password - voir https://myaccount.google.com/apppasswords)
SMTP_USER=votre.email@gmail.com
SMTP_PASS=votre-mot-de-passe-application
SMTP_FROM=Coucou Beach <votre.email@gmail.com>

# Propriétaire / destinataire des notifications
OWNER_EMAIL=votre.email@gmail.com
EMAIL_FROM=Coucou Beach <onboarding@resend.dev>

# API d'emails (optionnel, SMTP utilisé par défaut)
RESEND_API_KEY=re_xxxxx
BREVO_API_KEY=
SENDGRID_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# Base de données (Prisma)
DATABASE_URL=postgresql://user:password@host:5432/db